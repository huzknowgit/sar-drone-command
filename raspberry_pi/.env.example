# Required
SERVER_URL=ws://192.168.1.50:8080
DRONE_ID=drone_1
PI_IP=                          # leave blank for auto-detect

# Camera
CAMERA_SOURCE=0                 # 0 for first USB cam, /dev/video0, or rtsp://...
CAMERA_BACKEND=auto
CAMERA_FOURCC=MJPG
VIDEO_WIDTH=640
VIDEO_HEIGHT=360
VIDEO_FPS=15
JPEG_QUALITY=70
FAKE_VIDEO=false

# AI Detection
AI_ENABLED=true
AI_BACKEND=auto                 # auto, yolo, mobilenet, hog
AI_CONFIDENCE=0.45              # lower toward 0.30 if using a custom aerial-trained model
AI_MODEL_PATH=                  # path to a .pt weights file, e.g. models/your_model.pt
AI_INFERENCE_INTERVAL_S=0.5
AI_INFERENCE_SIZE=320           # 640 roughly triples small-person recall for ~2x inference time
AI_TILING=false                 # SAHI-style sliced inference; needs high-res frames (VIDEO_WIDTH >= ~1280) and costs one inference per tile
AI_TILE_SIZE=640
AI_TILE_OVERLAP=0.2
AI_ANNOTATE_FRAME=true
DETECTION_FRAME_INTERVAL_S=2.0

# Thermal Camera
THERMAL_ENABLED=false
THERMAL_MODE=simulate           # amg8833, lepton, simulate
THERMAL_I2C_BUS=1
THERMAL_DEVICE_PATH=/dev/video1
THERMAL_HOTSPOT_THRESHOLD_C=35.0

# Flight Controller
FC_ENABLED=false
FC_CONNECTION=/dev/ttyAMA0     # or /dev/ttyUSB0 or udp:127.0.0.1:14550
FC_BAUD=57600
FC_SITL_MODE=false             # set true for software simulation without real FC
